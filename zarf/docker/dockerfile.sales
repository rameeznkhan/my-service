FROM golang:1.27 as build_sales
ENV CGO_ENABLED 0
ARG BUILD_REF

COPY ./service

WORKDIR /service/apis/tooling/admin
RUN go build -ldflags "-X main.build=${BUILD_REF}"

# Run the Go Binary in Alpine.
FROM alpine:3.24
ARG BUILD_DATE
ARG BUILD_TAG
RUN addgroup -g 1000 -S sales && \
    adduser -u 1000 -h /service -G sales -S sales
COPY --from=build_sales --chown=sales:sales /service/api/tooling/admin/admin /service/admin
COPY --from=build_sales --chown=sales:sales /service/api/services/sales/sales /service/sales
WORKDIR /service
USER sales
CMD ["./sales"]

LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="sales-api" \
      org.opencontainers.image.authors="Rameez Khan" \
      org.opencontainers.image.source="https://github.com/rameeznkhan/my-service/tree/main/a/services/sales" \
org.opencontainers.image.revision="${BUILD_TAG}"